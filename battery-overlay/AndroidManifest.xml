<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nabu.batterycap"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Static RRO: overrides res/xml/power_profile of framework-res so the
         reported battery capacity matches the real 8720 mAh cell. -->
    <overlay
        android:targetPackage="android"
        android:priority="1"
        android:isStatic="true" />

    <!-- minSdk 26 / targetSdk 36: the tablet runs Android 16 (SDK 36). -->
    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <application
        android:hasCode="false"
        android:label="Battery capacity overlay" />

</manifest>
