diff --git a/KernelSU/kernel/supercall/supercall.c b/KernelSU/kernel/supercall/supercall.c
index 7008779..5bd101f 100644
--- a/KernelSU/kernel/supercall/supercall.c
+++ b/KernelSU/kernel/supercall/supercall.c
@@ -124,6 +124,17 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd, void __user
 
     // Check if this is a request to install KSU fd
     if (magic2 == KSU_INSTALL_MAGIC2) {
+        /*
+         * The descriptor installed here is an anonymous inode named
+         * [ksu_driver], and the ioctls that answer on it (GET_INFO,
+         * CHECK_SAFEMODE) are world-readable.  An unprivileged app could
+         * therefore call reboot(2) with the magic pair above and fingerprint
+         * KernelSU without ever gaining root.  The manager receives its
+         * descriptor from the setuid hook instead, so only the manager and
+         * root need this install path.
+         */
+        if (!manager_or_root())
+            return -EINVAL;
         int fd = ksu_install_fd();
         pr_info("[%d] install ksu fd: %d\n", current->pid, fd);
 
