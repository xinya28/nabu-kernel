Screen-gate autosleep: arm PM_SUSPEND_MEM only while the panel is off.

--- /dev/null
+++ b/kernel/power/nabu_autosleep_gate.c
@@ -0,0 +1,53 @@
+// Screen-gated autosleep for nabu.
+//
+// CONFIG_PM_AUTOSLEEP alone is not enough on this ported ROM: the framework
+// does not hold a wakelock while the display is on, so a plain
+// "autosleep = mem" suspends the SoC in the middle of normal use (visible as
+// the screen blanking at a regular interval). Arm autosleep only while the
+// panel is actually powered down, and disarm it on unblank.
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/suspend.h>
+#include <linux/msm_drm_notify.h>
+
+/*
+ * Declared in kernel/power/power.h, which is private to kernel/power. We live
+ * in that directory but do not include the private header, so declare it here.
+ */
+extern int pm_autosleep_set_state(suspend_state_t state);
+
+static int nabu_gate_cb(struct notifier_block *self, unsigned long event,
+			void *data)
+{
+	struct msm_drm_notifier *ev = data;
+	int blank;
+
+	if (!ev || !ev->data || event != MSM_DRM_EVENT_BLANK)
+		return NOTIFY_DONE;
+	if (ev->id != MSM_DRM_PRIMARY_DISPLAY)
+		return NOTIFY_DONE;
+
+	blank = *(int *)ev->data;
+	if (blank == MSM_DRM_BLANK_POWERDOWN)
+		pm_autosleep_set_state(PM_SUSPEND_MEM);
+	else
+		pm_autosleep_set_state(PM_SUSPEND_ON);
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block nabu_gate_nb = {
+	.notifier_call = nabu_gate_cb,
+	.priority = 100,
+};
+
+static int __init nabu_gate_init(void)
+{
+	/* Display is on at boot: keep autosleep off until it goes away. */
+	pm_autosleep_set_state(PM_SUSPEND_ON);
+	return msm_drm_register_client(&nabu_gate_nb);
+}
+late_initcall(nabu_gate_init);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("nabu: arm autosleep only while the panel is off");
